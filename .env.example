# Supabase project "Engagement" -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Background music (any YouTube link format works)
NEXT_PUBLIC_YOUTUBE_URL=https://youtu.be/S6vKGkoJh9g?si=-xsdhPndPSMEEGZ8
# Start time in seconds (0:30 = 30)
NEXT_PUBLIC_MUSIC_START=30
# End time in seconds; leave empty to play until the end of the video
NEXT_PUBLIC_MUSIC_END=157
NEXT_PUBLIC_SITE_URL=
